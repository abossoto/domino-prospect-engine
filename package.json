// ── HUBSPOT MODAL ─────────────────────────────────────────────────────────────
function HsModal({ token, setToken, result, onClose }) {
  const [syncing, setSyncing] = useState(false);
  const [msg, setMsg] = useState('');

  async function sync() {
    if (!token || !result?.prospect) return;
    setSyncing(true); setMsg('');
    try {
      // 1. Search company
      const searchRes = await fetch('https://api.hubapi.com/crm/v3/objects/companies/search', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ filterGroups: [{ filters: [{ propertyName: 'name', operator: 'EQ', value: result.prospect.nome }] }] }),
      });
      const searchData = await searchRes.json();
      let companyId;

      if (searchData.results?.length > 0) {
        companyId = searchData.results[0].id;
      } else {
        // 2. Create company
        const createRes = await fetch('https://api.hubapi.com/crm/v3/objects/companies', {
          method: 'POST',
          headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
          body: JSON.stringify({ properties: { name: result.prospect.nome, industry: result.prospect.settore || '' } }),
        });
        const createData = await createRes.json();
        companyId = createData.id;
      }

      // 3. Add note
      const noteBody = `[Domino Prospect Engine]\n\nDecisore: ${result.prospect.decisore_target || ''}\nHook: ${result.prospect.hook || ''}\nMaturità digitale: ${result.prospect.maturita_digitale || ''}\n\nMail oggetto: ${result.mail?.oggetto || ''}`;
      await fetch('https://api.hubapi.com/crm/v3/objects/notes', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ properties: { hs_note_body: noteBody, hs_timestamp: Date.now() } }),
      });

      setMsg(`✓ Sincronizzato su HubSpot (company ID: ${companyId})`);
    } catch (e) {
      setMsg(`⚠️ Errore: ${e.message}`);
    }
    setSyncing(false);
  }

  return (
    <div style={{ position: 'fixed', inset: 0, background: 'rgba(0,0,0,0.8)', zIndex: 100, display: 'flex', alignItems: 'center', justifyContent: 'center' }} onClick={onClose}>
      <div style={{ background: C.elevated, border: `1px solid ${C.border}`, borderRadius: 12, padding: 24, width: 420 }} onClick={e => e.stopPropagation()}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 16 }}>
          <div style={{ fontSize: 16, fontWeight: 700, color: C.text }}>HubSpot CRM</div>
          <button onClick={onClose} style={{ background: 'none', border: 'none', color: C.muted, cursor: 'pointer', fontSize: 18 }}>✕</button>
        </div>
        <div style={{ fontSize: 12, color: C.muted, marginBottom: 8 }}>Token HubSpot (pat-eu1-...)</div>
        <input
          value={token}
          onChange={e => { setToken(e.target.value); localStorage.setItem('domino_hs_token', e.target.value); }}
          placeholder="pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
          style={{ width: '100%', padding: '8px 10px', background: C.card, border: `1px solid ${C.border}`, borderRadius: 8, color: C.text, fontSize: 12, marginBottom: 12, boxSizing: 'border-box' }}
        />
        <button onClick={sync} disabled={syncing || !token} style={{
          width: '100%', padding: '10px', background: syncing ? C.card : C.accent,
          color: '#fff', border: 'none', borderRadius: 8, cursor: syncing ? 'not-allowed' : 'pointer',
          fontSize: 13, fontWeight: 600,
        }}>
          {syncing ? 'Sincronizzando...' : 'Sincronizza su HubSpot'}
        </button>
        {msg && <div style={{ fontSize: 12, color: msg.startsWith('✓') ? C.success : C.accent, marginTop: 10 }}>{msg}</div>}
      </div>
    </div>
  );
}

// ── LISTA PROSPECT ────────────────────────────────────────────────────────────
function ListaProspect({ onAnalizza }) {
  const [settore, setSettore] = useState('');
  const [geo, setGeo] = useState('Italia');
  const [dim, setDim] = useState([]);
  const [keywords, setKeywords] = useState('');
  const [numero, setNumero] = useState(10);
  const [loading, setLoading] = useState(false);
  const [loadMsg, setLoadMsg] = useState('');
  const [result, setResult] = useState(null);
  const [error, setError] = useState('');

  const msgRef = useRef(null);
  useEffect(() => {
    if (!loading) return;
    let i = 0;
    setLoadMsg(LISTA_MSGS[0]);
    msgRef.current = setInterval(() => {
      i = (i + 1) % LISTA_MSGS.length;
      setLoadMsg(LISTA_MSGS[i]);
    }, 8000);
    return () => clearInterval(msgRef.current);
  }, [loading]);

  function toggleDim(d) {
    setDim(prev => prev.includes(d) ? prev.filter(x => x !== d) : [...prev, d]);
  }

  async function genera() {
    if (!settore) return;
    setLoading(true); setError(''); setResult(null);
    try {
      const res = await fetch('/api/prospect-list', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ settore, geografia: geo, dimensione: dim, keywords, numero }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Errore API');
      setResult(data);
    } catch (e) {
      setError(e.message);
    }
    setLoading(false);
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>
      {/* Form */}
      <div style={{ background: C.elevated, borderRadius: 10, padding: 16, border: `1px solid ${C.border}` }}>
        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 12, marginBottom: 12 }}>
          <div>
            <div style={{ fontSize: 11, color: C.muted, marginBottom: 6 }}>Settore *</div>
            <select value={settore} onChange={e => setSettore(e.target.value)} style={{
              width: '100%', padding: '8px 10px', background: C.card, border: `1px solid ${C.border}`,
              borderRadius: 8, color: settore ? C.text : C.muted, fontSize: 13,
            }}>
              <option value="">Scegli settore...</option>
              {SETTORI_OPTIONS.map(s => <option key={s} value={s}>{s}</option>)}
            </select>
          </div>
          <div>
            <div style={{ fontSize: 11, color: C.muted, marginBottom: 6 }}>Geografia</div>
            <input value={geo} onChange={e => setGeo(e.target.value)} placeholder="Italia" style={{
              width: '100%', padding: '8px 10px', background: C.card, border: `1px solid ${C.border}`,
              borderRadius: 8, color: C.text, fontSize: 13, boxSizing: 'border-box',
            }} />
          </div>
        </div>
        <div style={{ marginBottom: 12 }}>
          <div style={{ fontSize: 11, color: C.muted, marginBottom: 6 }}>Dimensione</div>
          <div style={{ display: 'flex', gap: 8 }}>
            {['PMI', 'Mid-market', 'Enterprise'].map(d => (
              <button key={d} onClick={() => toggleDim(d)} style={{
                padding: '6px 12px', fontSize: 12, borderRadius: 6, cursor: 'pointer',
                background: dim.includes(d) ? C.accent : C.card,
                color: dim.includes(d) ? '#fff' : C.subtle,
                border: `1px solid ${dim.includes(d) ? C.accent : C.border}`,
              }}>{d}</button>
            ))}
          </div>
        </div>
        <div style={{ marginBottom: 12 }}>
          <div style={{ fontSize: 11, color: C.muted, marginBottom: 6 }}>Keyword aggiuntive (opzionale)</div>
          <input value={keywords} onChange={e => setKeywords(e.target.value)} placeholder="es. ecommerce, B2B, export, PMI in crescita..." style={{
            width: '100%', padding: '8px 10px', background: C.card, border: `1px solid ${C.border}`,
            borderRadius: 8, color: C.text, fontSize: 13, boxSizing: 'border-box',
          }} />
        </div>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
          <div style={{ display: 'flex', gap: 8 }}>
            {[5,10,20].map(n => (
              <button key={n} onClick={() => setNumero(n)} style={{
                padding: '6px 12px', fontSize: 12, borderRadius: 6, cursor: 'pointer',
                background: numero === n ? C.elevated : C.card,
                color: numero === n ? C.text : C.muted,
                border: `1px solid ${numero === n ? C.borderHover : C.border}`,
                fontWeight: numero === n ? 600 : 400,
              }}>{n} prospect</button>
            ))}
          </div>
          <button onClick={genera} disabled={loading || !settore} style={{
            padding: '10px 20px', background: loading || !settore ? C.card : C.accent,
            color: loading || !settore ? C.muted : '#fff', border: 'none', borderRadius: 8,
            cursor: loading || !settore ? 'not-allowed' : 'pointer', fontSize: 14, fontWeight: 600,
          }}>
            {loading ? loadMsg : 'Genera lista →'}
          </button>
        </div>
        {error && <div style={{ fontSize: 12, color: C.accent, marginTop: 8 }}>⚠️ {error}</div>}
      </div>

      {/* Risultati */}
      {result?.lista?.length > 0 && (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
          <div style={{ fontSize: 11, color: C.muted }}>
            {result.totale_trovate} prospect trovati · {result.criteri_applicati}
          </div>
          {result.lista.map((p, i) => (
            <div key={i} style={{ background: C.elevated, borderRadius: 10, padding: 14, border: `1px solid ${C.border}` }}>
              <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 12 }}>
                <div style={{ flex: 1 }}>
                  <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 4 }}>
                    <span style={{ fontSize: 14, fontWeight: 700, color: C.text }}>{p.nome}</span>
                    <Badge label={p.dimensione} color={C.subtle} bg={C.card} />
                  </div>
                  <div style={{ fontSize: 12, color: C.subtle }}>{p.settore} · {p.sede}</div>
                  {p.fatturato_stimato && <div style={{ fontSize: 11, color: C.muted }}>{p.fatturato_stimato}</div>}
                  <div style={{ fontSize: 12, color: C.text, marginTop: 6 }}>
                    <span style={{ color: C.accent }}>◆ </span>{p.segnale_principale}
                  </div>
                  <div style={{ fontSize: 11, color: C.muted, marginTop: 2 }}>Decisore: {p.decisore_probabile}</div>
                  {p.score_motivazione && <div style={{ fontSize: 11, color: C.subtle, marginTop: 2, fontStyle: 'italic' }}>{p.score_motivazione}</div>}
                </div>
                <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: 8, minWidth: 100 }}>
                  <div style={{ width: 80 }}><ScoreBar score={p.score} /></div>
                  <button onClick={() => onAnalizza(p.sito || p.nome)} style={{
                    fontSize: 11, padding: '4px 10px', background: C.accent, color: '#fff',
                    border: 'none', borderRadius: 6, cursor: 'pointer', fontWeight: 600,
                  }}>Analizza →</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// ── APP PRINCIPALE ────────────────────────────────────────────────────────────
export default function App() {
  const [mode, setMode] = useState('analizza');
  const [input, setInput] = useState('');
  const [note, setNote] = useState('');
  const [gtmLayer, setGtmLayer] = useState('usecases');
  const [gtmMotion, setGtmMotion] = useState('bottomup');
  const [loading, setLoading] = useState(false);
  const [loadMsg, setLoadMsg] = useState('');
  const [result, setResult] = useState(null);
  const [tab, setTab] = useState('intel');
  const [error, setError] = useState('');
  const [showArchive, setShowArchive] = useState(false);
  const [showHs, setShowHs] = useState(false);
  const [hsToken, setHsToken] = useState(() => localStorage.getItem('domino_hs_token') || '');
  const [archCount, setArchCount] = useState(() => loadArchive().length);

  const msgRef = useRef(null);
  useEffect(() => {
    if (!loading) return;
    let i = 0;
    setLoadMsg(LOADING_MSGS[0]);
    msgRef.current = setInterval(() => {
      i = (i + 1) % LOADING_MSGS.length;
      setLoadMsg(LOADING_MSGS[i]);
    }, 7500);
    return () => clearInterval(msgRef.current);
  }, [loading]);

  async function analizza() {
    if (!input.trim()) return;
    setLoading(true); setError(''); setResult(null);
    try {
      const res = await fetch('/api/analyze', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ prospect: input.trim(), note: note.trim(), layer: gtmLayer, motion: gtmMotion }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Errore API');
      setResult(data);
      setTab('intel');
      saveToArchive(data);
      setArchCount(loadArchive().length);
    } catch (e) {
      setError(e.message);
    }
    setLoading(false);
  }

  const tabs = [
    { id: 'intel',    label: '🔍 Intelligence' },
    { id: 'mail',     label: '✉️ Mail' },
    { id: 'deck',     label: '📊 Deck' },
    { id: 'workflow', label: '📅 Workflow' },
    { id: 'linkedin', label: '💼 LinkedIn' },
  ];

  return (
    <div style={{ minHeight: '100vh', background: C.bg, color: C.text, fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif' }}>

      {/* Header */}
      <div style={{ borderBottom: `1px solid ${C.border}`, padding: '14px 24px', display: 'flex', alignItems: 'center', justifyContent: 'space-between', position: 'sticky', top: 0, background: C.bg, zIndex: 10 }}>
        <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
          <span style={{ fontSize: 16, letterSpacing: 2 }}>
            <span style={{ color: C.accent }}>●</span>
            <span style={{ color: C.border }}>○</span>
            <span style={{ color: C.accent }}>●</span>
            <span style={{ color: C.border }}>○</span>
          </span>
          <span style={{ fontSize: 14, fontWeight: 600, color: C.text }}>Domino</span>
          <span style={{ color: C.border }}>|</span>
          <span style={{ fontSize: 14, color: C.muted }}>Prospect Engine</span>
        </div>
        <div style={{ display: 'flex', gap: 8 }}>
          <button onClick={() => setShowArchive(true)} style={{ padding: '6px 12px', background: C.elevated, border: `1px solid ${C.border}`, borderRadius: 7, color: C.subtle, fontSize: 12, cursor: 'pointer' }}>
            📂 Archivio ({archCount})
          </button>
          <button onClick={() => setShowHs(true)} style={{ padding: '6px 12px', background: C.elevated, border: `1px solid ${C.border}`, borderRadius: 7, color: C.subtle, fontSize: 12, cursor: 'pointer' }}>
            🔗 HubSpot
          </button>
        </div>
      </div>

      <div style={{ maxWidth: 960, margin: '0 auto', padding: '24px 24px' }}>

        {/* Mode switcher */}
        <div style={{ display: 'flex', gap: 8, marginBottom: 20 }}>
          {[{ id: 'analizza', label: '🔍 Analizza prospect' }, { id: 'lista', label: '📋 Genera lista' }].map(m => (
            <button key={m.id} onClick={() => setMode(m.id)} style={{
              padding: '8px 16px', fontSize: 13, fontWeight: 600, borderRadius: 8, cursor: 'pointer',
              background: mode === m.id ? C.accent : C.elevated,
              color: mode === m.id ? '#fff' : C.subtle,
              border: `1px solid ${mode === m.id ? C.accent : C.border}`,
            }}>{m.label}</button>
          ))}
        </div>

        {mode === 'lista' ? (
          <ListaProspect onAnalizza={(target) => { setInput(target); setMode('analizza'); }} />
        ) : (
          <>
            {/* Input form */}
            <div style={{ background: C.elevated, borderRadius: 12, padding: 20, marginBottom: 20, border: `1px solid ${C.border}` }}>
              <input
                value={input}
                onChange={e => setInput(e.target.value)}
                onKeyDown={e => e.key === 'Enter' && !e.shiftKey && analizza()}
                placeholder="Nome azienda o URL sito web..."
                style={{ width: '100%', padding: '12px 14px', background: C.card, border: `1px solid ${C.border}`, borderRadius: 8, color: C.text, fontSize: 15, marginBottom: 10, boxSizing: 'border-box', outline: 'none' }}
              />

              {/* Quick picks */}
              <div style={{ display: 'flex', gap: 6, flexWrap: 'wrap', marginBottom: 12 }}>
                {QUICK_PICKS.map(q => (
                  <button key={q} onClick={() => setInput(q)} style={{ fontSize: 11, padding: '3px 9px', background: C.card, border: `1px solid ${C.border}`, borderRadius: 5, color: C.muted, cursor: 'pointer' }}>
                    {q}
                  </button>
                ))}
              </div>

              <textarea
                value={note}
                onChange={e => setNote(e.target.value)}
                placeholder="Note commerciali (opzionale): contesto, referente, obiettivo..."
                rows={2}
                style={{ width: '100%', padding: '10px 12px', background: C.card, border: `1px solid ${C.border}`, borderRadius: 8, color: C.text, fontSize: 13, resize: 'vertical', marginBottom: 12, boxSizing: 'border-box', outline: 'none' }}
              />

              <GtmSelector layer={gtmLayer} setLayer={setGtmLayer} motion={gtmMotion} setMotion={setGtmMotion} />

              <button
                onClick={analizza}
                disabled={loading || !input.trim()}
                style={{ width: '100%', padding: '12px', background: loading || !input.trim() ? C.card : C.accent, color: loading || !input.trim() ? C.muted : '#fff', border: 'none', borderRadius: 8, cursor: loading || !input.trim() ? 'not-allowed' : 'pointer', fontSize: 15, fontWeight: 700 }}>
                {loading ? loadMsg : 'Analizza →'}
              </button>
              {error && <div style={{ fontSize: 12, color: C.accent, marginTop: 8 }}>⚠️ {error}</div>}
            </div>

            {/* Risultati */}
            {result && (
              <div>
                {/* Tab bar */}
                <div style={{ display: 'flex', gap: 4, marginBottom: 16, borderBottom: `1px solid ${C.border}`, paddingBottom: 0 }}>
                  {tabs.map(t => (
                    <button key={t.id} onClick={() => setTab(t.id)} style={{
                      padding: '8px 14px', fontSize: 12, fontWeight: tab === t.id ? 700 : 400,
                      color: tab === t.id ? C.text : C.muted, background: 'none', border: 'none',
                      borderBottom: tab === t.id ? `2px solid ${C.accent}` : '2px solid transparent',
                      cursor: 'pointer', marginBottom: -1,
                    }}>{t.label}</button>
                  ))}
                </div>

                {/* Tab content */}
                {tab === 'intel'    && <IntelTab prospect={result.prospect} />}
                {tab === 'mail'     && <MailTab mail={result.mail} />}
                {tab === 'deck'     && <DeckTab deck={result.deck} prospect={result.prospect} />}
                {tab === 'workflow' && <WorkflowTab workflow={result.workflow} />}
                {tab === 'linkedin' && <LinkedInTab linkedin={result.linkedin} />}
              </div>
            )}
          </>
        )}
      </div>

      {showArchive && (
        <ArchiveModal
          onClose={() => setShowArchive(false)}
          onSelect={(item) => { setResult(item); setMode('analizza'); setTab('intel'); }}
        />
      )}
      {showHs && (
        <HsModal
          token={hsToken}
          setToken={setHsToken}
          result={result}
          onClose={() => setShowHs(false)}
        />
      )}
    </div>
  );
}
