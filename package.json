            <div style={{ fontSize: 20, fontWeight: 700, color: C.text }}>{p.nome}</div>
            <div style={{ fontSize: 13, color: C.subtle, marginTop: 2 }}>{p.settore} · {p.dimensione} · {p.mercati}</div>
          </div>
