function DeckTab({ deck, prospect }) {
  if (!deck) return null;
  const slides = [1,2,3,4,5].map(n => ({
    n,
    titolo: deck[`slide_${n}_titolo`],
    contenuto: deck[`slide_${n}_contenuto`],
  }));

  const slideColors = ['#111111','#ffffff','#ffffff','#111111','#E8001C'];
  const slideTextColors = [C.text, '#111111', '#111111', C.text, '#ffffff'];

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 10 }}>
      {slides.map(s => (
        <div key={s.n} style={{ display: 'flex', gap: 12, background: C.elevated, borderRadius: 10, padding: 14, border: `1px solid ${C.border}` }}>
          <div style={{ width: 120, height: 68, borderRadius: 6, background: slideColors[s.n-1], flexShrink: 0, display: 'flex', alignItems: 'center', justifyContent: 'center', position: 'relative', overflow: 'hidden' }}>
            <div style={{ position: 'absolute', top: 6, right: 8, fontSize: 9, color: s.n <= 2 ? 'rgba(255,255,255,0.3)' : 'rgba(0,0,0,0.3)', fontWeight: 700 }}>{s.n}</div>
            {s.n !== 2 && s.n !== 3 && <div style={{ width: 3, position: 'absolute', left: 0, top: 0, bottom: 0, background: '#E8001C' }} />}
            <div style={{ fontSize: 8, fontWeight: 600, color: slideTextColors[s.n-1], textAlign: 'center', padding: '0 8px', lineHeight: 1.3 }}>{s.titolo}</div>
          </div>
          <div style={{ flex: 1 }}>
            <div style={{ fontSize: 13, fontWeight: 600, color: C.text, marginBottom: 4 }}>{s.titolo}</div>
            <div style={{ fontSize: 12, color: C.subtle, lineHeight: 1.5 }}>{s.contenuto}</div>
          </div>
        </div>
      ))}
      {prospect && <ExportPptBtn deck={deck} prospect={prospect} />}
    </div>
  );
}

function WorkflowTab({ workflow }) {
  if (!workflow?.length) return null;
  const canaleBg = { 'LinkedIn': C.blueBg, 'Email': 'rgba(34,197,94,0.1)', 'Telefono': 'rgba(245,158,11,0.1)' };
  const canaleColor = { 'LinkedIn': C.blue, 'Email': C.success, 'Telefono': '#f59e0b' };
  return (
    <div style={{ background: C.elevated, borderRadius: 10, padding: 16, border: `1px solid ${C.border}` }}>
      <div style={{ fontSize: 11, color: C.muted, textTransform: 'uppercase', letterSpacing: '.06em', marginBottom: 14 }}>
        Sequenza multicanale · 14 giorni
      </div>
      <div style={{ display: 'flex', flexDirection: 'column' }}>
        {workflow.map((step, i) => (
          <div key={i}>
            <div style={{ display: 'flex', gap: 14, alignItems: 'flex-start', padding: '12px 0' }}>
              <div style={{ fontSize: 22, fontWeight: 800, color: C.accent, minWidth: 36, lineHeight: 1 }}>
                {step.giorno}
              </div>
              <div style={{ flex: 1 }}>
                <span style={{ fontSize: 11, fontWeight: 600, padding: '2px 8px', borderRadius: 4, background: canaleBg[step.canale] || C.card, color: canaleColor[step.canale] || C.subtle }}>
                  {step.canale}
                </span>
                <div style={{ fontSize: 13, color: C.text, marginTop: 6, lineHeight: 1.5 }}>{step.azione}</div>
              </div>
            </div>
            {i < workflow.length - 1 && <div style={{ height: 1, background: C.border }} />}
          </div>
        ))}
      </div>
    </div>
  );
}

