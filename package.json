// ── EXPORT PPT ────────────────────────────────────────────────────────────────
function ExportPptBtn({ deck, prospect }) {
  const [exporting, setExporting] = useState(false);

  async function exportPpt() {
    setExporting(true);
    try {
      const pres = new pptxgen();
      pres.layout = 'LAYOUT_WIDE';
      const today = new Date().toLocaleDateString('it-IT');
      const nome = prospect?.nome || 'Prospect';

      const slides = [
        { bg: '111111', titleColor: 'FFFFFF', bodyColor: 'AAAAAA', dark: true },
        { bg: 'FFFFFF', titleColor: '111111', bodyColor: '444444', dark: false },
        { bg: 'FFFFFF', titleColor: '111111', bodyColor: '444444', dark: false },
        { bg: '111111', titleColor: 'FFFFFF', bodyColor: 'AAAAAA', dark: true },
        { bg: 'E8001C', titleColor: 'FFFFFF', bodyColor: 'FFCCCC', dark: true },
      ];

      for (let i = 1; i <= 5; i++) {
        const s = pres.addSlide();
        const sc = slides[i-1];
        s.background = { color: sc.bg };
        const titolo = deck[`slide_${i}_titolo`] || '';
        const contenuto = deck[`slide_${i}_contenuto`] || '';

        // Logo
        s.addText('domino', { x: 0.4, y: 0.25, w: 2, h: 0.3, fontSize: 11, bold: true, color: 'E8001C', charSpacing: 2 });
        s.addText(`${i}`, { x: 12.7, y: 0.25, w: 0.4, h: 0.3, fontSize: 9, color: 'E8001C', align: 'right' });

        // Barra rossa sinistra (non su slide 1 e 5)
        if (!sc.dark) {
          s.addShape('rect', { x: 0.4, y: 0.65, w: 0.05, h: 0.7, fill: { color: 'E8001C' }, line: { color: 'E8001C' } });
        }

        // Prospect name (grigio piccolo)
        s.addText(nome, { x: 0.4, y: 0.85, w: 12, h: 0.3, fontSize: 11, color: sc.dark ? '666666' : '999999' });

        // Titolo
        s.addText(titolo, {
          x: 0.4, y: 1.3, w: 12.3, h: 1.2,
          fontSize: 34, bold: true, color: sc.titleColor,
          charSpacing: -1, wrap: true, valign: 'top',
        });

        // Contenuto
        s.addText(contenuto, {
          x: 0.4, y: 2.8, w: 12.3, h: 3.5,
          fontSize: 15, color: sc.bodyColor, lineSpacingMultiple: 1.4, wrap: true, valign: 'top',
        });

        // Case study KPI su slide 4
        if (i === 4 && prospect?.casi_studio?.length) {
          const cs = prospect.casi_studio;
          const csColors = ['E8001C', '3b82f6', '666666'];
          cs.slice(0, 3).forEach((c, ci) => {
            const x = 0.4 + ci * 4.3;
            s.addShape('rect', { x, y: 5.6, w: 4.0, h: 0.05, fill: { color: csColors[ci] }, line: { color: csColors[ci] } });
            s.addText(c.cliente, { x, y: 5.7, w: 4.0, h: 0.3, fontSize: 12, bold: true, color: 'FFFFFF' });
            s.addText(c.kpi, { x, y: 6.0, w: 4.0, h: 0.3, fontSize: 11, color: '4ADE80' });
          });
        }

        // Footer slide 5
        if (i === 5) {
          s.addText('domino.it · +39 011 544770 · Torino & Venezia', {
            x: 0.4, y: 6.9, w: 12.3, h: 0.3, fontSize: 10, color: 'FFAAAA', align: 'center',
          });
        } else {
          s.addText(`${today} · domino.it`, { x: 0.4, y: 7.1, w: 12, h: 0.2, fontSize: 9, color: '444444' });
        }
      }

      const kebab = nome.toLowerCase().replace(/[^a-z0-9]+/g, '-');
      await pres.writeFile({ fileName: `domino-prospect-${kebab}.pptx` });
    } catch (e) {
      console.error('PPT export error:', e);
    }
    setExporting(false);
  }

  return (
    <button onClick={exportPpt} disabled={exporting} style={{
      padding: '10px 18px', background: exporting ? C.elevated : C.accent,
      color: '#fff', border: 'none', borderRadius: 8, cursor: exporting ? 'not-allowed' : 'pointer',
      fontSize: 13, fontWeight: 600, alignSelf: 'flex-start',
    }}>
      {exporting ? 'Generando PPT...' : '⬇ Esporta PPT'}
    </button>
  );
}

