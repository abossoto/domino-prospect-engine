      <div style={{ background: C.elevated, borderRadius: 10, padding: 16, border: `1px solid ${C.border}` }}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 10 }}>
          <div style={{ fontSize: 11, color: C.muted, textTransform: 'uppercase', letterSpacing: '.06em' }}>Oggetto</div>
          <CopyBtn text={mail.oggetto} />
        </div>
        <div style={{ fontSize: 14, fontWeight: 600, color: C.text }}>{mail.oggetto}</div>
      </div>
      <div style={{ background: C.elevated, borderRadius: 10, padding: 16, border: `1px solid ${C.border}` }}>
        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 10 }}>
          <div style={{ fontSize: 11, color: C.muted, textTransform: 'uppercase', letterSpacing: '.06em' }}>Corpo</div>
