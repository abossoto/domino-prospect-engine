// ── ARCHIVIO ──────────────────────────────────────────────────────────────────
function loadArchive() {
  try { return JSON.parse(localStorage.getItem('domino_pe_arch') || '[]'); }
  catch { return []; }
}

// FIX: esclude fonti_ricerca dall'archivio per non saturare localStorage
function saveToArchive(r) {
  const a = loadArchive();
  const { fonti_ricerca, ...rSenza } = r;
  a.unshift({ ...rSenza, _savedAt: new Date().toISOString() });
  localStorage.setItem('domino_pe_arch', JSON.stringify(a.slice(0, 50)));
}

// ── HELPERS UI ────────────────────────────────────────────────────────────────
function CopyBtn({ text }) {
  const [copied, setCopied] = useState(false);
  return (
    <button
      onClick={() => { navigator.clipboard.writeText(text); setCopied(true); setTimeout(() => setCopied(false), 2000); }}
      style={{ fontSize: 11, padding: '4px 10px', background: copied ? C.successBg : C.elevated,
        color: copied ? C.success : C.subtle, border: `1px solid ${C.border}`,
        borderRadius: 6, cursor: 'pointer' }}>
      {copied ? '✓ Copiato' : 'Copia'}
    </button>
  );
}

function Badge({ label, color, bg }) {
  return (
    <span style={{ fontSize: 11, fontWeight: 600, padding: '2px 8px',
      borderRadius: 4, background: bg || C.elevated, color: color || C.subtle }}>
      {label}
    </span>
  );
}

function ScoreBar({ score }) {
  const color = score >= 8 ? C.success : score >= 6 ? '#f59e0b' : C.subtle;
  return (
    <div style={{ display: 'flex', alignItems: 'center', gap: 8 }}>
      <div style={{ flex: 1, height: 4, background: C.border, borderRadius: 2 }}>
        <div style={{ width: `${score * 10}%`, height: '100%', background: color, borderRadius: 2 }} />
      </div>
      <span style={{ fontSize: 12, fontWeight: 700, color, minWidth: 20 }}>{score}</span>
    </div>
  );
}

// ── GTM SELECTOR ──────────────────────────────────────────────────────────────
function GtmSelector({ layer, setLayer, motion, setMotion }) {
  return (
    <div style={{ background: C.elevated, border: `1px solid ${C.border}`, borderRadius: 10, padding: '14px 16px', marginBottom: 14 }}>
      <div style={{ fontSize: 11, color: C.muted, textTransform: 'uppercase', letterSpacing: '.06em', marginBottom: 10 }}>
        GTM Layer — chi è il destinatario?
      </div>
      <div style={{ display: 'flex', flexDirection: 'column', gap: 6, marginBottom: 14 }}>
        {GTM_LAYERS.map(l => (
          <div key={l.id} onClick={() => setLayer(l.id)} style={{
            display: 'flex', alignItems: 'center', gap: 10, padding: '8px 12px', borderRadius: 8,
            border: `1px solid ${layer === l.id ? l.color : C.border}`,
            background: layer === l.id ? l.bg : 'transparent',
            cursor: 'pointer', transition: 'all .15s',
          }}>
            <div style={{ width: 3, height: 32, borderRadius: 2, background: l.color, flexShrink: 0 }} />
            <div style={{ flex: 1 }}>
              <div style={{ fontSize: 12, fontWeight: 600, color: layer === l.id ? C.text : C.subtle }}>{l.label}</div>
              <div style={{ fontSize: 11, color: C.muted, fontStyle: 'italic' }}>{l.interlocutore} · {l.need}</div>
            </div>
            {layer === l.id && <div style={{ width: 8, height: 8, borderRadius: '50%', background: l.color }} />}
          </div>
        ))}
      </div>
      <div style={{ fontSize: 11, color: C.muted, textTransform: 'uppercase', letterSpacing: '.06em', marginBottom: 8 }}>
        Motion — come stai entrando?
      </div>
      <div style={{ display: 'flex', gap: 8 }}>
        {GTM_MOTIONS.map(m => (
          <div key={m.id} onClick={() => setMotion(m.id)} style={{
            flex: 1, padding: '10px 12px', borderRadius: 8, cursor: 'pointer',
            border: `1px solid ${motion === m.id ? 'rgba(255,255,255,0.3)' : C.border}`,
            background: motion === m.id ? 'rgba(255,255,255,0.05)' : 'transparent',
            transition: 'all .15s',
          }}>
            <div style={{ fontSize: 12, fontWeight: 700, color: C.text }}>{m.label}</div>
            <div style={{ fontSize: 11, color: C.muted, marginTop: 2 }}>{m.desc}</div>
            <div style={{ fontSize: 10, color: C.accent, marginTop: 4 }}>{m.sub}</div>
          </div>
        ))}
      </div>
    </div>
  );
}

// ── TABS ──────────────────────────────────────────────────────────────────────
