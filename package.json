        {p.hook && (
          <div style={{ background: 'rgba(232,0,28,0.08)', border: `1px solid rgba(232,0,28,0.2)`, borderRadius: 8, padding: '10px 12px' }}>
            <div style={{ fontSize: 10, color: C.accent, fontWeight: 600, letterSpacing: '.06em', marginBottom: 4 }}>HOOK COMMERCIALE</div>
